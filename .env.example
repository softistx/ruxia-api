# Copy to .env (never commit it). Bun loads .env on every command.
# Placeholders only: the values below are examples, not secrets.

NODE_ENV=development
PORT=3000

# One database; transactions need a replica set (docker-compose.yaml).
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DATABASE=ruxia

# The UI's origin (every mailed link starts with it) and the From address.
UI_ORIGIN=http://localhost:5173
MAIL_FROM=noreply@ruxia.test

# Shared with ruxia-ui's BFF (at least 32 characters). Required in production.
API_PROXY_SECRET=

# Mail: an smtp:// URL, or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD.
# Unset outside production, mails are printed to the console.
MAIL_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_SERVERNAME=

# Rate limits count here. Unset outside production, nothing is throttled.
REDIS_URL=redis://localhost:6379

# The Ollama server the health probe asks every 30 s (the Mac, over Tailscale).
# Unset, the probe does not run and every Ollama model is unavailable. Needs REDIS_URL.
OLLAMA_BASE_URL=

# The key Claude models are called with. Optional: unset, a send to a Claude
# model fails with a model error.
ANTHROPIC_API_KEY=

# The cheap model that titles a conversation (default claude-haiku-5-5); if it
# is not enabled, the conversation's own model does.
TITLE_MODEL_ID=

# S3-compatible store (avatars). All optional.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# id:key, each key 32 random bytes in base64 (openssl rand -base64 32). The
# first seals new TOTP secrets, every one opens. Required in production.
TOTP_KEYS=
