{
  "name": "ruxia-api",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nxgt-graphql-scalars typedefs --out && nxgt-graphql-validation typedefs --out && bun --bun run graphql-codegen --config codegen.ts",
    "dev": "docker compose up -d --wait && bun run dev:api",
    "dev:api": "NODE_ENV=development bun --watch src/server.ts",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "build": "bun run generate && bun build.ts",
    "start": "NODE_ENV=production bun dist/server.js",
    "db:sync": "bun src/scripts/db-sync.ts",
    "db:migrate": "bun src/scripts/db-migrate.ts",
    "schema:print": "bun src/scripts/schema-print.ts",
    "schema:check": "bun src/scripts/schema-check.ts && bun src/scripts/schema-print.ts --check",
    "admin:create": "bun src/scripts/admin-create/index.ts",
    "test": "bun test --timeout=15000",
    "typecheck": "bun check",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "check:ci": "biome ci",
    "verify": "bun run generate && bun run schema:check && bun run check:ci && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^8.0.9",
    "@graphql-tools/merge": "^10.0.9",
    "@softistx/ai-anthropic": "^0.5.0",
    "@softistx/ai-core": "^0.8.0",
    "@softistx/ai-memory": "^0.6.3",
    "@softistx/ai-ollama": "^0.4.0",
    "@softistx/alxia": "^0.28.0",
    "@softistx/alxia-env": "^0.6.0",
    "@softistx/alxia-graphql": "^0.20.1",
    "@softistx/alxia-i18n": "^0.7.0",
    "@softistx/alxia-language": "^0.4.0",
    "@softistx/alxia-media": "^0.12.0",
    "@softistx/graphql-scalars": "^0.8.0",
    "@softistx/graphql-validation": "^0.10.0",
    "@softistx/graxia": "^0.17.2",
    "@softistx/graxia-graphiql": "^0.4.1",
    "@softistx/i18n": "^3.2.1",
    "@softistx/image": "^0.6.0",
    "@softistx/janus": "^0.81.0",
    "@softistx/janus-graphql": "^0.38.2",
    "@softistx/janus-mail": "^0.26.25",
    "@softistx/janus-mongo": "^0.33.1",
    "@softistx/janus-passkeys": "^0.3.29",
    "@softistx/mail": "^1.6.1",
    "@softistx/mail-smtp": "^1.1.1",
    "@softistx/mongo": "^0.31.0",
    "@softistx/redis": "^0.24.1",
    "@softistx/s3": "^0.13.1",
    "dataloader": "^2.2.3",
    "graphql": "^17.1.0",
    "intl-messageformat": "^12.2.1",
    "mongodb": "^7.9.1",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-resolvers": "7.0.1",
    "@graphql-tools/utils": "^13.2.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@softistx/ai-testing": "^0.3.3",
    "@softistx/graphql-codegen-zod": "^0.6.0",
    "@types/bun": "^1.4.5",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server-core": "^11.4.0",
    "redis-memory-server": "^0.17.2",
    "typescript": "^7.0.2"
  }
}
