# Copy to .env (mode 600, never committed) and fill every value.
UI_ORIGIN=https://ruxia.example.com
MAIL_FROM=noreply@ruxia.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_SERVERNAME=
# At least 32 characters, shared with ruxia-ui's BFF.
API_PROXY_SECRET=
# id:key, each key 32 random bytes in base64 (openssl rand -base64 32).
TOTP_KEYS=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# The read token of the @softistx packages, for `bun install` in the image.
NPM_SOFTISTX_READ_TOKEN=
