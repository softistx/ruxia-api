"Who serves a model."
enum ModelProvider {
  "Anthropic's Claude API."
  ANTHROPIC
  "An Ollama server (the owner's Mac): free, and offline when the Mac is off."
  OLLAMA
}

"What a model can do in a conversation."
enum ModelCapability {
  "It can call tools."
  TOOLS
  "It reads images."
  VISION
  "It can think before answering."
  THINKING
  "It can search the web through the provider's own tool."
  WEB_SEARCH
}

"""
A model a conversation may pick (spec 2). Claude models are seeded; Ollama
models are found by a probe and stay disabled until an administrator enables
them.
"""
type Model {
  "The model's public id, e.g. `claude-sonnet-5-5` or `ollama:qwen3:14b`."
  id: ID!
  "Who serves it."
  provider: ModelProvider!
  "The name shown to people."
  label: String!
  "What it can do."
  capabilities: [ModelCapability!]!
  "How many tokens of context it holds."
  contextWindow: Int!
  """
  Whether a send to it can succeed now. Always true for a Claude model; an
  Ollama model is available while its server answers and has it installed
  (a probe every 30 seconds), so false means "offline".
  """
  available: Boolean!
  "Whether an administrator allows conversations to use it."
  enabled: Boolean!
  "USD per million input tokens; null when it is free."
  inputPrice: Float
  "USD per million output tokens; null when it is free."
  outputPrice: Float
}

extend type Query {
  """
  The models, Claude first, then by name. Members see the enabled ones;
  `includeDisabled: true` also lists the disabled and is for administrators
  only: 403 `auth.errors.forbidden`.
  """
  models(
    "Also list the models an administrator has not enabled."
    includeDisabled: Boolean = false
  ): [Model!]!
}

extend type Mutation {
  """
  Enables or disables a model for conversations (a no-op when it already is).
  Administrators only: 403 `auth.errors.forbidden`. 404
  `models.errors.not-found` for an id that names no model.
  """
  setModelEnabled(
    "The model's public id."
    id: ID! @constraint(maxLength: 200)
    "Whether conversations may use it."
    enabled: Boolean!
  ): Model!
}
