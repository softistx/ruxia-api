"What to send in a conversation."
input SendMessageInput {
  "The conversation to write in."
  conversationId: ID! @constraint(maxLength: 64)
  """
  The assistant message the new one follows. Left out: the end of the branch
  shown (`Conversation.activeLeafId`). Naming an earlier assistant message
  starts a new branch there.
  """
  parentId: ID @constraint(maxLength: 64)
  "What the member says."
  text: String! @constraint(minLength: 1, maxLength: 20000)
  """
  Attachments to send with the text (at most 10): each is the member's own
  unlinked upload or one already in this conversation. All or nothing: any that
  cannot be attached refuses the send with `attachments.errors.not-attachable`
  on `attachmentIds.<i>`, and nothing is written.
  """
  attachmentIds: [ID!] @constraint(maxItems: 10, maxLength: 64)
}

"""
A send's outcome: the answer is being written by a run that goes on whether or
not the client stays. Follow it at `GET /runs/<runId>/events`.
"""
type SendMessagePayload {
  "The run's id: the reply message's id. Open `GET /runs/<runId>/events` with it."
  runId: ID!
  "The member's message, written."
  userMessage: Message!
  "The assistant's message, STREAMING until the run ends."
  reply: Message!
  "The conversation, its `activeRunId` and `activeLeafId` now pointing at the reply."
  conversation: Conversation!
}

extend type Mutation {
  """
  Sends a message and starts the run that answers it. 404
  `conversations.errors.not-found`; 400 `validation.errors.invalid-input` with
  `parentId` invalid (`conversations.errors.invalid-parent`) or an attachment id
  that cannot be attached (`attachments.errors.not-attachable`); 409
  `conversations.errors.run-in-progress` while an answer is still being written
  in the conversation; 409 `conversations.errors.persona-unavailable` once the
  persona is someone else's PRIVATE one; 409 `models.errors.offline` or
  `models.errors.disabled` for a model that cannot answer (nothing is written);
  429 `conversations.errors.too-many-messages`.
  """
  sendMessage(
    "The conversation, its parent message and the text."
    input: SendMessageInput!
  ): SendMessagePayload!

  """
  Stops the run of an answer being written: the reply keeps what was written
  and becomes STOPPED. Stopping a run that already ended returns its message
  unchanged. 404 `conversations.errors.run-not-found` for an unknown run or
  another member's (the admin's too).
  """
  stopRun(
    "The run's id (the reply message's id)."
    runId: ID! @constraint(maxLength: 64)
  ): Message!

  """
  Edits a message of the member's: writes a sibling message (same parent, so
  a new branch) with `text` and starts the reply, as `sendMessage` does (the
  same limits and checks; the branch shown becomes the new one). 404
  `conversations.errors.message-not-found`; 409
  `conversations.errors.not-editable` for an answer, plus `sendMessage`'s.
  """
  editMessage(
    "The message to edit."
    messageId: ID! @constraint(maxLength: 64)
    "What the member says now."
    text: String! @constraint(minLength: 1, maxLength: 20000)
    "The attachments of the new message (at most 10), as `SendMessageInput.attachmentIds`; none are inherited from the edited message."
    attachmentIds: [ID!] @constraint(maxItems: 10, maxLength: 64)
  ): SendMessagePayload!

  """
  Writes a new reply to the same member's message, as a new run and a new
  branch. `modelId` becomes the conversation's model. 404
  `conversations.errors.message-not-found`; 409
  `conversations.errors.not-regenerable` for a member's message,
  `conversations.errors.model-unavailable` (field `modelId`), plus
  `sendMessage`'s.
  """
  regenerate(
    "The answer to answer again."
    messageId: ID! @constraint(maxLength: 64)
    "The model to answer with; the conversation's when left out."
    modelId: String @constraint(minLength: 1, maxLength: 200)
  ): SendMessagePayload!
}
